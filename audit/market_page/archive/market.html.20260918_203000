<script>
const API_BASE='';
async function fetchJSON(path){try{const ts=Date.now();const res=await fetch(API_BASE+'/api/'+path);if(!res.ok)return null;return await res.json();}catch{return null;}}
function formatPrice(p){return p!=null?p.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}):'-';}
function formatChange(p){if(p==null)return'-';return(p>=0?'+':'')+p.toFixed(2);}
function regimeColor(regime){if(!regime)return'#64748b';const r=regime.toUpperCase();if(r.includes('BULLISH'))return'#15803d';if(r.includes('BEARISH'))return'#dc2626';if(r.includes('RANGE'))return'#a16207';if(r.includes('VOLATILITY'))return'#c2410c';return'#64748b';}
let refreshInterval=null;
function isMarketHours(){const now=new Date();const ist=new Date(now.toLocaleString('en-US',{timeZone:'Asia/Kolkata'}));const day=ist.getDay();if(day===0||day===6)return false;const h=ist.getHours();const m=ist.getMinutes();const mins=h*60+m;return mins>=570&&mins<990;}
function fmtIST(ts){try{if(ts==null||ts==='')return null;var d=new Date(ts);if(isNaN(d.getTime()))return null;var f=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Kolkata',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});var p={};f.formatToParts(d).forEach(function(x){p[x.type]=x.value;});return p.day+' '+p.month+' '+p.year+', '+p.hour+':'+p.minute+':'+p.second;}catch(e){return null;}}function setLastUpdated(timestamp,ok){var bar=document.getElementById('last-updated-bar');if(!bar)return;if(timestamp){var _lastDataTs=timestamp;var show=fmtIST(timestamp);if(ok===false){bar.style.color='#dc2626';bar.textContent='Update failed — retrying'+(show?(' | Data as of '+show+' IST'):'');return;}bar.style.color='';if(!show){bar.textContent='Last refreshed: —';return;}bar.textContent='Data as of '+show+' IST';}}function tickClock(){var el=document.getElementById('live-clock');if(!el)return;try{el.textContent=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Kolkata',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date())+' IST';}catch(e){}}setInterval(tickClock,1000);tickClock();
function startDataRefresh(callback,intervalMs){stopDataRefresh();var tick=function(){callback();refreshInterval=setTimeout(tick,intervalMs||(window.marketRefreshMs?window.marketRefreshMs():20000));};tick();}
function stopDataRefresh(){if(refreshInterval){clearInterval(refreshInterval);refreshInterval=null;}}

const BRAND={NIFTY:{c:'#15803d',d:'nseindia.com'},BANKNIFTY:{c:'#1d4ed8',d:'nseindia.com'},FINNIFTY:{c:'#7c3aed',d:'nseindia.com'},SENSEX:{c:'#c2410c',d:'bseindia.com'}};

async function loadMarket(){
  const data=await fetchJSON('market');
  if(!data){setLastUpdated(null,false);return;}
  var hero=document.getElementById('market-hero');
  if(hero){
    var insts=data.instruments||{};
    var n=insts.NIFTY,b=insts.BANKNIFTY,se=insts.SENSEX,vx=insts.VIX;
    var today=new Date().toLocaleDateString('en-GB',{timeZone:'Asia/Kolkata',day:'numeric',month:'long',year:'numeric'});
    var vprice=vx?(vx.price!=null?vx.price:vx.close):null;
    var vChg=vx?(vx.change!=null?vx.change:0):0;
    var vChgPct=vx?(vx.change_pct!=null?vx.change_pct:0):0;
    if(vprice==null||vx==null){try{var vxd=await fetchJSON('vix');if(vxd){vprice=vxd.price!=null?vxd.price:vxd.close;vChg=vxd.change!=null?vxd.change:0;vChgPct=vxd.change_pct!=null?vxd.change_pct:0;}}catch(e){}}
    hero.innerHTML='<div class="status" style="color:#d1fae5">MARKET PULSE — '+today+'</div>'+
      '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-top:0.5rem">'+
      '<div class="tile" style="background:rgba(255,255,255,0.12);border:1px solid transparent;cursor:pointer" onclick="location.href=\'indices/nifty.html\'"><div style="color:#d1fae5;font-weight:700">NIFTY</div><div style="color:#fff;font-size:1.5rem;font-weight:800">'+formatPrice(n?.quote?.price)+'</div><div style="color:'+(n?.quote?.change>=0?'#86efac':'#fca5a5')+';font-weight:bold">'+(n?.quote?.change>=0?'+':'')+formatChange(n?.quote?.change)+' ('+(n?.quote?.change_pct>=0?'+':'')+formatChange(n?.quote?.change_pct)+'%)</div></div>'+
      '<div class="tile" style="background:rgba(255,255,255,0.12);border:1px solid transparent;cursor:pointer" onclick="location.href=\'indices/banknifty.html\'"><div style="color:#d1fae5;font-weight:700">BANKNIFTY</div><div style="color:#fff;font-size:1.5rem;font-weight:800">'+formatPrice(b?.quote?.price)+'</div><div style="color:'+(b?.quote?.change>=0?'#86efac':'#fca5a5')+';font-weight:bold">'+(b?.quote?.change>=0?'+':'')+formatChange(b?.quote?.change)+' ('+(b?.quote?.change_pct>=0?'+':'')+formatChange(b?.quote?.change_pct)+'%)</div></div>'+
      '<div class="tile" style="background:rgba(255,255,255,0.12);border:1px solid transparent;cursor:pointer" onclick="location.href=\'indices/sensex.html\'"><div style="color:#d1fae5;font-weight:700">SENSEX</div><div style="color:#fff;font-size:1.5rem;font-weight:800">'+formatPrice(se?.quote?.price)+'</div><div style="color:'+(se?.quote?.change>=0?'#86efac':'#fca5a5')+';font-weight:bold">'+(se?.quote?.change>=0?'+':'')+formatChange(se?.quote?.change)+' ('+(se?.quote?.change_pct>=0?'+':'')+formatChange(se?.quote?.change_pct)+'%)</div></div>'+
      '<div class="tile" style="background:rgba(255,255,255,0.12);border:1px solid transparent"><div style="color:#d1fae5;font-weight:700">India VIX</div><div style="color:#fff;font-size:1.5rem;font-weight:800">'+(vprice!=null?formatPrice(vprice):'—')+'</div><div style="color:'+(vChg>=0?'#86efac':'#fca5a5')+';font-weight:bold">'+(vChg>=0?'+':'')+formatChange(vChg)+' ('+(vChgPct>=0?'+':'')+formatChange(vChgPct)+'%)</div></div>'+
      '</div>';
  }
  var grid=document.getElementById('market-grid');
  if(grid){
    var _sy=window.scrollY;
    var html='';
    for(var symbol in data.instruments){
      var inst=data.instruments[symbol];
      if(!inst||!inst.quote)continue;
      var col=BRAND[symbol]?BRAND[symbol].c:'#64748b';
      html+='<div class="card" style="cursor:pointer;border-left:4px solid '+col+'" onclick="location.href=\''+(['NIFTY','BANKNIFTY','FINNIFTY','SENSEX'].includes(symbol)?'indices/'+symbol.toLowerCase()+'.html':'stock.html?symbol='+symbol)+'\'">'+
        '<h3>'+symbol+'</h3>'+
        '<div class="price">'+formatPrice(inst.quote.price)+'</div>'+
        '<div style="color:'+(inst.quote.change>=0?'#15803d':'#dc2626')+'">'+(inst.quote.change>=0?'+':'')+formatChange(inst.quote.change)+' ('+(inst.quote.change_pct>=0?'+':'')+formatChange(inst.quote.change_pct)+'%)</div>'+
        '<span class="badge" style="background:'+regimeColor(inst.regime?.regime)+'20;color:'+regimeColor(inst.regime?.regime)+'">'+(inst.regime?.regime||'N/A')+'</span>'+
        '<div class="status">VWAP: '+formatPrice(inst.indicators?.vwap)+' | RSI: '+(inst.indicators?.rsi?.toFixed(1)||'N/A')+'</div>'+
        '<div class="status">Support: '+(inst.indicators?.support_resistance?.support||[]).join(', ')+' | Resistance: '+(inst.indicators?.support_resistance?.resistance||[]).join(', ')+'</div>'+
        '</div>';
    }
    grid.innerHTML=html;
    document.getElementById('market-grid-fallback').style.display='none';
  }
  setLastUpdated(data.last_updated,true);
  window.scrollTo(0,_sy);

  // Populate technical snapshot from market data
  try{
    var tech=await fetchJSON('market');
    if(tech&&tech.instruments&&tech.instruments.NIFTY){
      var ind=tech.instruments.NIFTY.indicators||{};
      var vwap=document.getElementById('t-vwap');if(vwap&&ind.vwap!=null){vwap.textContent=formatPrice(ind.vwap);vwap.style.color='';}
      var rsi=document.getElementById('t-rsi');if(rsi&&ind.rsi!=null){rsi.textContent=ind.rsi.toFixed(1);rsi.style.color='';}
      var adx=document.getElementById('t-adx');if(adx&&ind.adx!=null){adx.textContent=ind.adx.toFixed(0);adx.style.color='';}
      var macd=document.getElementById('t-macd');if(macd&&ind.macd!=null){macd.textContent=ind.macd.toFixed(2);macd.style.color='';}
    }
  }catch(e){}

  // Populate market regime
  try{
    var mkt=await fetchJSON('market');
    var regimeEl=document.getElementById('market-regime');
    if(regimeEl&&mkt&&mkt.regime){
      var r=mkt.regime;
      regimeEl.innerHTML='<div style="font-size:1.2rem;font-weight:700;color:'+regimeColor(r.primary)+'">'+r.primary+'</div><div class="status">Confidence: '+(r.confidence||'—')+'%</div><div class="status">Volatility favors: '+(r.volatility_favours||'—')+'</div>';
    }
  }catch(e){}

  // Populate breadth
  try{
    var br=await fetchJSON('breadth');
    var brel=document.getElementById('market-breadth');
    if(brel&&br){
      brel.innerHTML='<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">'+
        '<div class="card" style="padding:0.8rem"><div style="font-size:0.8rem;color:#64748b;font-weight:600">Advances</div><div style="font-size:1.3rem;font-weight:800;color:#15803d">'+(br.advances||'—')+'</div></div>'+
        '<div class="card" style="padding:0.8rem"><div style="font-size:0.8rem;color:#64748b;font-weight:600">Declines</div><div style="font-size:1.3rem;font-weight:800;color:#ef4444">'+(br.declines||'—')+'</div></div>'+
        '<div class="card" style="padding:0.8rem"><div style="font-size:0.8rem;color:#64748b;font-weight:600">Unchanged</div><div style="font-size:1.3rem;font-weight:800;color:#64748b">'+(br.unchanged||'—')+'</div></div>'+
        '<div class="card" style="padding:0.8rem"><div style="font-size:0.8rem;color:#64748b;font-weight:600">A/D Ratio</div><div style="font-size:1.3rem;font-weight:800">'+(br.advance_decline_ratio||'—')+'</div></div>'+
        '</div>';
    }
  }catch(e){}

  // Populate sector data
  try{
    var sec=await fetchJSON('sectors');
    var secEl=document.getElementById('market-sector');
    if(secEl&&sec&&sec.sectors){
      var sh='';
      sec.sectors.slice(0,6).forEach(function(s){sh+='<div class="status" style="margin-bottom:0.3rem"><strong>'+s.name+'</strong>: '+s.change_pct+'% ('+s.change+')</div>';});
      secEl.innerHTML=sh||'<div class="status">Sector data pending</div>';
    }
  }catch(e){}
}
document.addEventListener('DOMContentLoaded',function(){loadMarket();startDataRefresh(loadMarket);});
</script>
<script>
(function(){var BASE='';
async function tapeTick(){try{var el=document.getElementById('ticker-track');if(!el)return;
var m=null,ib=null;
try{m=await(await fetch(BASE+'/api/market')).json();}catch(e){}
try{ib=await(await fetch(BASE+'/api/index-breadth')).json();}catch(e){}
var items=[];
if(m&&m.instruments){for(var s in m.instruments){var inst=m.instruments[s];var q=inst.quote||{};if(q.price==null)continue;var up=(q.change||0)>=0;
items.push('<span><strong>'+s+'</strong> '+Number(q.price).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2})+' <span style="color:'+(up?'#22c55e':'#ef4444')+'">'+(up?'▲':'▼')+Math.abs(q.change_pct||0).toFixed(2)+'%</span></span>');}}
if(ib&&ib.length){for(var i=0;i<ib.length;i++){var b=ib[i];items.push('<span><strong>'+b.index_name+' A/D</strong> <span style="color:#22c55e">'+b.advances+'↑</span>/<span style="color:#ef4444">'+b.declines+'↓</span></span>');}}
if(!items.length)return;var html=items.join('');el.innerHTML=html+html;}catch(e){}}
document.addEventListener('DOMContentLoaded',function(){tapeTick();setInterval(tapeTick,60000);});
})();
</script>
