<script>
(function(){
var REFRESH_MS=30000, STALE_S=900;
function $(id){return document.getElementById(id);}
function fmt(n){if(n===null||n===undefined||isNaN(Number(n)))return null;return Number(n).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtInt(n){if(n===null||n===undefined||isNaN(Number(n)))return null;return Math.round(Number(n)).toLocaleString('en-IN');}
function istclock(){try{var d=new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Kolkata'}));return d.toTimeString().slice(0,8);}catch(e){return new Date().toLocaleTimeString();}}
function tick(){$('clock').textContent=istclock();}
setInterval(tick,1000);tick();
function setUnavail(prefix,msg){
  [prefix+'Price'].forEach(function(){});
  $(prefix+'Price').textContent='—';
  $(prefix+'Chg').textContent='';
  $(prefix+'Chg').className='chg flat';
  $(prefix+'Sub').textContent=msg;
}
function renderSide(p,d){
  var P=$(p+'Price'),C=$(p+'Chg'),S=$(p+'Sub'),D=$(p+'Dir'),banner=p==='nifty'?$('bannerNifty'):(p==='bank'?$('bannerBank'):$('bannerVix'));
  var live=(d&&d.live_price!==null&&d.live_price!==undefined&&!isNaN(Number(d.live_price)));
  if(!live){P.textContent='DATA UNAVAILABLE';S.textContent='No price from engine.';D.textContent='—';banner.textContent='—';banner.className='unknown';return;}
  var prev=P.textContent;
  P.textContent=fmt(d.live_price);
  if(prev!==P.textContent){P.classList.add('flash');setTimeout(function(){P.classList.remove('flash');},350);}
  var ch=(d.change===null||d.change===undefined)?NaN:Number(d.change);
  var cp=(d.change_pct===null||d.change_pct===undefined)?NaN:Number(d.change_pct);
  if(!isNaN(ch)&&!isNaN(cp)){var s=(ch>=0?'+':'')+fmt(ch)+' ('+(cp>=0?'+':'')+cp.toFixed(2)+'%) '+(ch>0?'▲':ch<0?'▼':'■');C.textContent=s;C.className='chg '+(ch>0?'up':ch<0?'down':'flat');}
  else{C.textContent='';C.className='chg flat';}
  var qts=d.quote_timestamp?(' · Quote '+String(d.quote_timestamp).slice(11,19)+' IST'):'';
  S.textContent='Session '+d.session+' · '+(d.quote_state||d.state)+qts;
  // Direction comes ONLY from engine evidence (market_bias). Never invented.
  var bias=d.market_bias||null;
  if(bias==='BULLISH'){D.textContent='🟢 BULLISH';D.className='dir-pill bull';banner.textContent='BULLISH ▲';banner.className='bull';$(p+'DirSub').textContent='Market Direction ↗';}
  else if(bias==='BEARISH'){D.textContent='🔴 BEARISH';D.className='dir-pill bear';banner.textContent='BEARISH ▼';banner.className='bear';$(p+'DirSub').textContent='Market Direction ↘';}
  else if(bias==='NEUTRAL'){D.textContent='⚪ NEUTRAL';D.className='dir-pill neutral';banner.textContent='NEUTRAL ■';banner.className='neutral';$(p+'DirSub').textContent='Market Direction →';}
  else{D.textContent='—';D.className='dir-pill';banner.textContent='—';banner.className='unknown';$(p+'DirSub').textContent='Direction: DATA UNAVAILABLE';}
}
var candleCache={NIFTY:[],BANKNIFTY:[],INDIA_VIX:[]}, candleDay='';
function drawMiniChart(cvId,candles,cpr,livePrice,todayStr){
  var cv=$(cvId);if(!cv)return;
  var dpr=window.devicePixelRatio||1;
  var box=cv.parentNode.getBoundingClientRect();
  var W=Math.max(260,Math.floor(box.width-8)),H=220;
  cv.width=W*dpr;cv.height=H*dpr;cv.style.height=H+'px';
  var g=cv.getContext('2d');g.setTransform(dpr,0,0,dpr,0,0);g.clearRect(0,0,W,H);
  g.font='10px -apple-system,Segoe UI,Roboto,sans-serif';
  var rows=(candles||[]).filter(function(cd){return String(cd.timestamp).slice(0,10)===todayStr;});
  var lv=[];
  if(cpr&&cpr.available){lv=[['R2',cpr.r2,'#dc2626'],['R1',cpr.r1,'#dc2626'],['TC',cpr.tc,'#2563eb'],['BC',cpr.bc,'#2563eb'],['S1',cpr.s1,'#16a34a'],['S2',cpr.s2,'#16a34a']];}
  var all=[];
  rows.forEach(function(cd){all.push(cd.high,cd.low);});
  lv.forEach(function(L){all.push(L[1]);});
  if(livePrice!=null&&!isNaN(Number(livePrice)))all.push(Number(livePrice));
  if(!all.length){g.fillStyle='#64748b';g.fillText('No data yet today.',10,20);return;}
  var mn=Math.min.apply(null,all),mx=Math.max.apply(null,all),pad=(mx-mn)*0.1||1;mn-=pad;mx+=pad;
  var pL=4,pR=62,pT=10,pB=18,pW=W-pL-pR,pH=H-pT-pB;
  function X(i,n){return pL+(i+0.5)*pW/Math.max(1,n);}
  function Y(v){return pT+(mx-v)/(mx-mn)*pH;}
  g.strokeStyle='#e2e8f0';g.fillStyle='#64748b';g.lineWidth=1;
  for(var gi=0;gi<=3;gi++){var gv=mx-(mx-mn)*gi/3,gy=Math.round(Y(gv))+0.5;
    g.beginPath();g.moveTo(pL,gy);g.lineTo(pL+pW,gy);g.stroke();
    g.fillText(Number(gv).toLocaleString('en-IN',{maximumFractionDigits:1}),pL+pW+4,gy+3);}
  if(cpr&&cpr.available){g.fillStyle='rgba(37,99,235,0.08)';g.fillRect(pL,Y(cpr.tc),pW,Math.max(1,Y(cpr.bc)-Y(cpr.tc)));}
  lv.forEach(function(L){
    var y=Math.round(Y(L[1]))+0.5;
    g.strokeStyle=L[2];g.setLineDash([5,4]);g.lineWidth=1;
    g.beginPath();g.moveTo(pL,y);g.lineTo(pL+pW,y);g.stroke();g.setLineDash([]);
    g.fillStyle=L[2];g.fillText(L[0],pL+2,y-3);
  });
  var n=rows.length,bw=Math.max(2,pW/Math.max(1,n)*0.55);
  rows.forEach(function(cd,i){
    var up=Number(cd.close)>=Number(cd.open);
    g.strokeStyle=up?'#16a34a':'#dc2626';g.fillStyle=up?'#16a34a':'#dc2626';g.lineWidth=1;
    var x=X(i,n);
    g.beginPath();g.moveTo(x,Y(cd.high));g.lineTo(x,Y(cd.low));g.stroke();
    var yO=Y(cd.open),yC=Y(cd.close);
    g.fillRect(x-bw/2,Math.min(yO,yC),bw,Math.max(1,Math.abs(yC-yO)));
  });
  if(livePrice!=null&&!isNaN(Number(livePrice))){
    var py=Math.round(Y(Number(livePrice)))+0.5;
    g.strokeStyle='#0f172a';g.setLineDash([6,4]);g.lineWidth=1.5;
    g.beginPath();g.moveTo(pL,py);g.lineTo(pL+pW,py);g.stroke();g.setLineDash([]);
  }
}
function renderChart(p,sym,d){
  var cvId=p==='nifty'?'niftyChart':(p==='bank'?'bankChart':'vixChart');
  var lbl=p==='nifty'?$('niftyCprLbl'):(p==='bank'?$('bankCprLbl'):null);
  var c=(d&&d.cpr)||null;
  if(sym==='INDIA_VIX'){c=null;}  // VIX: price chart only, no CPR overlay
  var price=(d&&(d.live_price!=null&&!isNaN(Number(d.live_price))))?Number(d.live_price):(d&&(d.price!=null&&!isNaN(Number(d.price)))?Number(d.price):null);
  if(c&&c.available){
    if(lbl){lbl.textContent='CPR: '+fmt(c.bc)+' – '+fmt(c.tc)+' ('+c.cpr_type+')';}
  }else if(lbl){lbl.textContent='CPR: DATA UNAVAILABLE';}
  var todayStr=d&&d.timestamp?String(d.timestamp).slice(0,10):candleDay;
  drawMiniChart(cvId,candleCache[sym]||[],c,price,todayStr);
}
function renderStrat(p,d,dec){
  var pill=$(p+'Pill'),name=$(p+'StratName'),st=$(p+'Status'),why=$(p+'Why'),box=$(p+'Strat');
  box.className='strat';
  var src=dec||d||{};
  var decision=src.decision||null;
  var reasons=((src.reason_codes)||(src.engine_reasons)||[]).join('; ');
  if(decision==='TRADE'&&src.strategy&&src.strategy!=='NONE'){
    pill.textContent='TRADE';pill.className='trade-pill trade';box.classList.add('trade');
    name.textContent=src.strategy+(src.strategy_direction?' — '+src.strategy_direction:'');
    st.textContent='TRADE';
    var rr=src.risk_reward!=null?(' RR '+src.risk_reward):'';
    why.textContent='Why: '+(src.structure||reasons||'Engine qualified this setup.')+' Entry '+src.entry_zone+', stop '+src.invalidation+', target '+src.target+rr+'.';
  }else if(decision==='WAIT'){
    pill.textContent='WAIT';pill.className='trade-pill wait';box.classList.add('wait');
    name.textContent=(src.strategy&&src.strategy!=='NONE')?src.strategy:'Setup developing — no entry yet';
    st.textContent='WAIT';why.textContent='Why: '+(reasons||'Trigger/confirmation incomplete on the latest completed 5-minute candle.');
  }else if(decision==='NO TRADE'){
    pill.textContent='NO TRADE';pill.className='trade-pill notrade';box.classList.add('notrade');
    name.textContent=(src.strategy&&src.strategy!=='NONE')?src.strategy:'No validated setup';
    st.textContent='NO TRADE';why.textContent='Why: '+(reasons||'Conditions do not match a validated strategy.');
  }else{
    var state=(dec&&dec.state)||(d&&d.state)||'NO_DATA';
    if(state==='QUALIFIED'&&dec&&dec.trade){
      pill.textContent='TRADE';pill.className='trade-pill trade';box.classList.add('trade');
      name.textContent=(dec.trade.strategy||'Qualified setup');
      st.textContent='TRADE';
      why.textContent='Why: '+(reasons||'Engine qualified this setup.')+' Entry '+dec.trade.entry+', stop '+dec.trade.stop+', target '+dec.trade.target+'.';
    }else{
      pill.textContent='—';pill.className='trade-pill';name.textContent='Connecting…';st.textContent='—';why.textContent='Connecting to engine…';
    }
  }
}
function esc(s){return String(s==null?'—':s).replace(/&/g,'&amp;').replace(/</g,'&lt;');}
function renderDetail(p,d){
  var el=$(p+'DetailBody');if(!el)return;
  if(!d){el.innerHTML='Engine unreachable.';return;}
  function row(k,v){return '<dt>'+k+'</dt><dd>'+esc(v)+'</dd>';}
  var h='<dl>';
  h+=row('Bias',d.market_bias)+row('Regime',d.market_regime)+row('Decision',d.decision);
  h+=row('Strategy',d.strategy)+(d.strategy_direction?row('Direction',d.strategy_direction):'');
  if(p!=='vix'&&d.cpr&&d.cpr.available){
    h+=row('CPR session',d.cpr.session)+row('Pivot',fmt(d.cpr.pivot))+row('BC',fmt(d.cpr.bc))+row('TC',fmt(d.cpr.tc));
    h+=row('CPR type',d.cpr.cpr_type+' ('+d.cpr.width_pct+'%)');
    h+=row('S1 / S2',fmt(d.cpr.s1)+' / '+fmt(d.cpr.s2))+row('R1 / R2',fmt(d.cpr.r1)+' / '+fmt(d.cpr.r2));
    h+=row('Gap',(d.gap_direction||'—')+' '+(d.gap_points==null?'':d.gap_points));
    h+=row('Position',d.cpr.price_position||'—');
  }else{h+=row('CPR','DATA UNAVAILABLE');}
  h+=row('Trigger',d.trigger)+row('Confirmation',d.confirmation)+row('Entry',d.entry_zone);
  h+=row('Invalidation',d.invalidation)+row('Target',d.target);
  h+=row('Risk / Reward',(d.risk_pct==null?'—':d.risk_pct+'%')+' / '+(d.reward_pct==null?'—':d.reward_pct+'%')+(d.risk_reward==null?'':' (RR '+d.risk_reward+')'));
  h+=row('Engine state',d.engine_state)+row('Data status',d.data_status);
  h+=row('Data time',(d.timestamp||'').slice(0,19).replace('T',' ')+' IST');
  h+='</dl><div class="codes">Evidence: '+esc((d.reason_codes||[]).join(' · ')||'—')+'</div>';
  el.innerHTML=h;
}
function renderStruct(list){
  var el=$('structChips');var st=list.map(function(x){return x.session+':'+x.state;}).join(' ');
  if(/STALE/.test(st)){el.innerHTML='<span class="chip">Feed: <b>STALE — last values shown, not tradable</b></span>';}
  else if(/PREMARKET|CLOSED|WEEKEND/.test(st)){el.innerHTML='<span class="chip">Market: <b>'+st+'</b></span><span class="chip">Structure signals resume at <b>09:15 IST</b></span>';}
  else{el.innerHTML='<span class="chip">Market: <b>'+st+'</b></span>';}
}
var failures=0;
var lastGood={};
async function tickPrice(){
  var syms=['NIFTY','BANKNIFTY','INDIA_VIX'],sides=['nifty','bank','vix'];
  for(var i=0;i<3;i++){
    try{
      var r=await fetch('/api/quote/'+syms[i].toLowerCase(),{cache:'no-store'});
      if(!r.ok)continue;
      var q=(await r.json()).data||null;
      if(!q||q.price==null||!lastGood[syms[i]])continue;
      var d={};
      for(var k in lastGood[syms[i]]){d[k]=lastGood[syms[i]][k];}
      d.live_price=q.price;d.price=q.price;d.change=q.change;d.change_pct=q.change_pct;
      d.quote_timestamp=q.timestamp;d.quote_state=q.state;
      renderSide(sides[i],d);renderChart(sides[i],syms[i],d);
    }catch(e){}
  }
}
async function load(){
  var out={};var limited=[];
  for(var i=0;i<3;i++){
    var sym=i===0?'NIFTY':(i===1?'BANKNIFTY':'INDIA_VIX');
    try{
      var r2=await fetch('/api/decision/'+sym.toLowerCase(),{cache:'no-store'});
      if(r2.status===429){
        limited.push(sym);
        if(lastGood[sym]){out[sym]=lastGood[sym];out[sym+'_DEC']=lastGood[sym+'_DEC'];}
        else{out[sym]=null;out[sym+'_DEC']=null;}
        continue;
      }
      if(!r2.ok)throw new Error('HTTP '+r2.status);
      var j2=await r2.json();out[sym+'_DEC']=j2.data||null;out[sym]=j2.data||null;
      lastGood[sym]=out[sym];lastGood[sym+'_DEC']=out[sym+'_DEC'];
    }catch(e){out[sym]=null;out[sym+'_DEC']=null;}
  }
  var n=out.NIFTY,b=out.BANKNIFTY,v=out.INDIA_VIX;
  if(!n&&!b&&!v){
    failures++;
    $('globalStatus').textContent='⛔ DATA TEMPORARILY UNAVAILABLE — engine unreachable (attempt '+failures+'). Retrying on next cycle.';
    $('globalFresh').textContent='';
    $('marketState').textContent='OFFLINE';$('livePill').textContent='DOWN';
    $('liveDot').className='live-dot';$('livePill').className='live-pill';
    setUnavail('nifty','Engine unreachable.');setUnavail('bank','Engine unreachable.');setUnavail('vix','Engine unreachable.');
    renderChart('nifty','NIFTY',null);renderChart('bank','BANKNIFTY',null);renderChart('vix','INDIA_VIX',null);
    renderStrat('nifty',null,null);renderStrat('bank',null,null);renderStrat('vix',null,null);
    renderDetail('nifty',null);renderDetail('bank',null);renderDetail('vix',null);
    $('structChips').innerHTML='<span class="chip">Engine unreachable — <b>DATA TEMPORARILY UNAVAILABLE</b></span>';
    return;
  }
  failures=0;
  var now=n&&n.now_ist?n.now_ist:((b&&b.now_ist)?b.now_ist:((v&&v.now_ist)?v.now_ist:''));
  var sess=(n&&n.session)||(b&&b.session)||(v&&v.session)||'—';
  var stale=((n&&n.quote_state)==='STALE')||((b&&b.quote_state)==='STALE')||((v&&v.quote_state)==='STALE');
  var dot=$('liveDot'),pill=$('livePill'),ms=$('marketState');
  if(sess==='LIVE'&&!stale){ms.textContent='● LIVE';pill.textContent='Live';dot.className='live-dot on';pill.className='live-pill on';}
  else if(stale){ms.textContent='⚠ DATA STALE';pill.textContent='Stale';dot.className='live-dot stale';pill.className='live-pill stale';}
  else{ms.textContent=sess==='PREMARKET'?'MARKET PREMARKET':sess;pill.textContent=sess;dot.className='live-dot';pill.className='live-pill';}
  function age(d){if(!d||d.quote_age_seconds===null||d.quote_age_seconds===undefined)return '—';var s=Math.round(d.quote_age_seconds);if(s<90)return s+'s ago';return Math.round(s/60)+'m ago';}
  $('globalStatus').textContent=(sess==='LIVE'&&!stale?'● LIVE':'○ '+sess)+' — NIFTY '+(n?n.state:'NO_DATA')+', BANKNIFTY '+(b?b.state:'NO_DATA')+', VIX '+(v?v.state:'NO_DATA');
  $('globalFresh').textContent='Updated '+(now?now.slice(11,19)+' IST':'—')+' · NIFTY quote '+age(n)+' · BANKNIFTY quote '+age(b)+' · VIX quote '+age(v);
  renderSide('nifty',n);renderSide('bank',b);renderSide('vix',v);
  try{
    var cn=await fetch('/api/nifty/candles?n=75',{cache:'no-store'});
    if(cn.ok){var jn=await cn.json();candleCache.NIFTY=((jn.data||{}).candles)||[];}
    var cb=await fetch('/api/banknifty/candles?n=75',{cache:'no-store'});
    if(cb.ok){var jb=await cb.json();candleCache.BANKNIFTY=((jb.data||{}).candles)||[];}
    var cv=await fetch('/api/india_vix/candles?n=75',{cache:'no-store'});
    if(cv.ok){var jv=await cv.json();candleCache.INDIA_VIX=((jv.data||{}).candles)||[];}
    candleDay=String((n&&n.timestamp)||(b&&b.timestamp)||(v&&v.timestamp)||'').slice(0,10);
  }catch(e){}
  renderChart('nifty','NIFTY',n);renderChart('bank','BANKNIFTY',b);renderChart('vix','INDIA_VIX',v);
  renderStrat('nifty',n,out.NIFTY_DEC);renderStrat('bank',b,out.BANKNIFTY_DEC);renderStrat('vix',v,out.INDIA_VIX_DEC);
  renderDetail('nifty',out.NIFTY_DEC||n);renderDetail('bank',out.BANKNIFTY_DEC||b);renderDetail('vix',out.INDIA_VIX_DEC||v);
  if(limited.length){
    $('globalFresh').textContent='Refresh delayed by rate limit ('+limited.join(', ')+') — showing last values, retrying on next cycle.';
  }
  renderStruct([{session:(n&&n.session)||'—',state:(n&&n.state)||'NO_DATA'},{session:(b&&b.session)||'—',state:(b&&b.state)||'NO_DATA'},{session:(v&&v.session)||'—',state:(v&&v.state)||'NO_DATA'}]);
  $('footLive').textContent=(sess==='LIVE'&&!stale)?'Live Market Data':'Session '+sess+' · '+(now?now.slice(0,16):'');
}
load();setInterval(load,300000);setInterval(tickPrice,60000);
})();
</script>
