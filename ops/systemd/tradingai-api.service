[Unit]
Description=TradingAI Flask API (port 8000)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tradingai/backend
ExecStart=/usr/bin/python3 api_server.py
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=mixed
StandardOutput=append:/opt/tradingai/logs/api_server.log
StandardError=append:/opt/tradingai/logs/api_server.log
Environment=API_PORT=8000
# 1GB VM: let OOM killer prefer other processes, not the API
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target
