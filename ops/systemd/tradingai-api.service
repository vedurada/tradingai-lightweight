[Unit]
Description=TradingAI Flask API (gunicorn, port 8000)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tradingai/backend
Environment=API_PORT=8000
ExecStart=/usr/local/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 90 --graceful-timeout 15 --access-logfile /opt/tradingai/logs/gunicorn-access.log --error-logfile /opt/tradingai/logs/gunicorn-error.log api_server:app
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=60
KillMode=mixed
StandardOutput=append:/opt/tradingai/logs/gunicorn-out.log
StandardError=append:/opt/tradingai/logs/gunicorn-err.log
# 1GB VM: let OOM killer prefer other processes, not the API
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target