[Unit]
Description=TradingAI Flask API (gunicorn, port 8000)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tradingai
Environment=API_PORT=8000
ExecStart=/usr/local/bin/gunicorn -w 2 --threads 4 --worker-class gthread --bind 127.0.0.1:8000 --timeout 90 --graceful-timeout 15 --keep-alive 5 --max-requests 1000 --max-requests-jitter 800 --access-logfile /opt/tradingai/logs/gunicorn-access.log --error-logfile /opt/tradingai/logs/gunicorn-error.log --access-logformat '%(h)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s" %(D)s' app.api.app:app
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=60
KillMode=mixed
StandardOutput=append:/opt/tradingai/logs/gunicorn-out.log
StandardError=append:/opt/tradingai/logs/gunicorn-err.log
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target
