[Unit]
Description=TradingAI SMA9 ATM CE/PE BUY-ONLY Paper Scanner, aligned 5min Poll
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sma95min
# Share the API's group so SQLite WAL/journal files created by the scanner are
# readable/writable by the ubuntu API process (see UMask below).
Group=ubuntu
WorkingDirectory=/opt/tradingai
Environment=SMA9_5MIN_DB_PATH=/opt/tradingai/database/sma9_5min.db
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/tradingai/sma9_5min_scanner
ExecStart=/usr/bin/python3 /opt/tradingai/sma9_5min_scanner/app/live_sma9_5min_scanner.py
# SQLite creates -shm/-wal with the main file's mode; keep the DB writable so
# both the scanner and the read-only API process can always open it.
ExecStartPre=+/bin/sh -c 'chmod 0666 /opt/tradingai/database/sma9_5min.db* 2>/dev/null || true'
Restart=always
RestartSec=5
StandardOutput=append:/opt/tradingai/logs/live_sma9_5min_scanner.log
StandardError=append:/opt/tradingai/logs/live_sma9_5min_scanner.log

# Sandbox / privilege hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/tradingai/database /opt/tradingai/logs
ReadOnlyPaths=/opt/tradingai/sma9_5min_scanner
# Group read/write (not world) so the ubuntu API can share SQLite -wal/-shm.
UMask=0007

[Install]
WantedBy=multi-user.target
